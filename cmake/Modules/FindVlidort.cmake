# Locate Vlidort library


FIND_LIBRARY(_VLIDORT_LIBRARY
  NAMES vlidort
  HINTS $ENV{VLIDORT_DIR} ${VLIDORT_DIR}
  PATH_SUFFIXES lib64 lib
)

IF(_VLIDORT_LIBRARY)
    SET(VLIDORT_LIBRARIES
        "${_VLIDORT_LIBRARY}" CACHE STRING "Vlidort Libraries")
ENDIF(_VLIDORT_LIBRARY)

INCLUDE(FindPackageHandleStandardArgs)
FIND_PACKAGE_HANDLE_STANDARD_ARGS(Vlidort DEFAULT_MSG VLIDORT_LIBRARIES)
